# ─── Render / Production Environment Variables ─────────────────────────────
# Copy these variable NAMES into your Render service's "Environment" settings.
# NEVER commit actual secret values to GitHub.

# MongoDB Atlas connection string (required for persistent data)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret — use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret_string

# Your deployed Render service URL (for CORS)
CLIENT_URL=https://your-service-name.onrender.com

# Node environment
NODE_ENV=production

# Port — Render sets this automatically, do not override
# PORT=5000
